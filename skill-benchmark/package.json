{
  "name": "scientific-figure-skill-benchmark",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "preflight": "python3 scripts/benchmark_preflight.py",
    "preflight:static": "python3 scripts/benchmark_preflight.py --allow-missing-scientific --allow-missing-auth",
